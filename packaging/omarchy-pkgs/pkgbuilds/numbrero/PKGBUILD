pkgname=numbrero
pkgver=0.1.0
pkgrel=1
pkgdesc='Fast plain-text variable calculator scratchpad for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/joonsp/numbrero'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 build/numbrero "$pkgdir/usr/bin/numbrero"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/numbrero.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/numbrero.svg"
  install -Dm644 pkgbuild/numbrero.desktop "$pkgdir/usr/share/applications/numbrero.desktop"
}
